<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="#0A0A1A">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="KESTREL LAG"
        android:textColor="#A080FF"
        android:textSize="24sp"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginBottom="4dp"/>

    <TextView
        android:id="@+id/status_txt"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="STOPPED"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:gravity="center"
        android:layout_marginBottom="32dp"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Lag (chặn outgoing)"
        android:textColor="#CCCCCC"
        android:textSize="13sp"/>

    <SeekBar
        android:id="@+id/lag_duration"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>

    <TextView
        android:id="@+id/lag_val"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="300ms"
        android:textColor="#A080FF"
        android:textSize="12sp"
        android:gravity="end"
        android:layout_marginBottom="16dp"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Open (gửi buffer)"
        android:textColor="#CCCCCC"
        android:textSize="13sp"/>

    <SeekBar
        android:id="@+id/open_duration"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>

    <TextView
        android:id="@+id/open_val"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="700ms"
        android:textColor="#A080FF"
        android:textSize="12sp"
        android:gravity="end"
        android:layout_marginBottom="32dp"/>

    <Button
        android:id="@+id/toggle_btn"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="START"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:textStyle="bold"
        android:background="#6030E0"
        android:layout_marginBottom="12dp"/>

    <Button
        android:id="@+id/overlay_btn"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="FLOATING BUTTON"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:background="#303060"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Bật FLOATING BUTTON → icon nổi trên màn hình. Bấm icon bật/tắt lag. Kéo di chuyển."
        android:textColor="#888888"
        android:textSize="11sp"
        android:layout_marginTop="24dp"
        android:gravity="center"/>

</LinearLayout>
